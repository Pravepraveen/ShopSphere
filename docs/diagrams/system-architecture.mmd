graph TD
    Client["Client Browser<br/>(React 18 + TypeScript SPA)"]
    Nginx["Nginx Reverse Proxy & Static Server<br/>(Port 8080)"]
    Backend["Spring Boot 3.3.4 Application<br/>(Java 21 LTS - Port 8081 / 8080)"]
    MySQL[("MySQL 8.0 Database Engine<br/>(Port 3306)")]

    Client -->|HTTP GET / Assets| Nginx
