    subgraph BackendServices["Spring Boot Core Engine"]
        Security["Spring Security 6<br/>Stateless JWT + BCrypt"]
        Catalog["Catalog & Inventory<br/>Atomic Row Updates"]
        Pricing["Server Pricing Engine<br/>BigDecimal Arithmetic"]
        Checkout["Checkout & Idempotency<br/>Unique Key Constraint"]
        StateMachine["Order State Machine<br/>Audited Transitions"]
        Coupons["Coupon Validation Engine<br/>Atomic Limit Tracking"]
    end

    Backend --> Security
    Backend --> Catalog
    Backend --> Pricing
    Backend --> Checkout
    Backend --> StateMachine
    Backend --> Coupons

    Catalog -->|Atomic UPDATE ... WHERE stock >= qty| MySQL
