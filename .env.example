# ShopSphere Environment Variables Configuration Template
# Copy this file to .env and adjust values for local or container deployment

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shopsphere
DB_USERNAME=shopsphere_user
DB_PASSWORD=shopsphere_secret
MYSQL_ROOT_PASSWORD=root_secret_change_me

# JWT Security
# 256-bit secret key for HMAC-SHA256 (Base64 encoded or raw string >= 32 chars)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1

